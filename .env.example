# ---------------------------------------------------------------------------
# Copie para .env.local (dev) ou configure no painel da Vercel (produção).
# NUNCA commite o arquivo com valores reais.
# ---------------------------------------------------------------------------

# --- Supabase (produção) ---------------------------------------------------
# Sem estas duas variáveis o app roda em modo dev com JSON local (.data/).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# --- Segredos --------------------------------------------------------------
# Assinatura HMAC dos tokens de licença (32+ caracteres aleatórios).
# Gere com: openssl rand -hex 32
LICENSE_HMAC_SECRET=

# Token do painel /api/admin. Sem ele o painel fica desligado em produção.
# Gere com: openssl rand -hex 24
ADMIN_TOKEN=

# --- Ajustes opcionais -----------------------------------------------------
# Prefixo das keys (padrão: ENJOY)
LICENSE_KEY_PREFIX=ENJOY

# Validade do token de licença em dias (padrão: 30). Depois disso o app precisa
# revalidar no servidor — é o que faz a revogação chegar ao cliente.
LICENSE_TOKEN_TTL_DAYS=30
