{
  "name": "license-key-server",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de licenças por key: ativação por dispositivo, expiração, revogação e painel admin (Next.js + Supabase + Vercel)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "keys:new": "node scripts/new-key.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
